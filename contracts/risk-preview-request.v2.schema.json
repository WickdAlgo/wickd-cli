{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WickdAlgo/wickd-api/contracts/risk-preview-request.v2.schema.json",
  "title": "RiskPreviewRequest",
  "type": "object",
  "properties": {
    "plan": {
      "$ref": "#/$defs/SetupRiskRequest"
    },
    "instrumentSpecVersionId": {
      "type": "string",
      "minLength": 1
    },
    "decisionAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "balanceBasisReceiptId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "required": [
    "plan",
    "instrumentSpecVersionId",
    "decisionAtUtc",
    "balanceBasisReceiptId"
  ],
  "$defs": {
    "SetupRiskTarget": {
      "type": "object",
      "properties": {
        "ordinal": {
          "type": "integer"
        },
        "price": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        },
        "exitFraction": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        }
      },
      "required": [
        "ordinal",
        "price",
        "exitFraction"
      ]
    },
    "SetupRiskRequest": {
      "type": "object",
      "properties": {
        "walletId": {
          "type": "string",
          "minLength": 1
        },
        "instrumentId": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": [
            "long",
            "short"
          ]
        },
        "entryPrice": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        },
        "stopPrice": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        },
        "sizingKind": {
          "type": "string",
          "enum": [
            "riskAmount",
            "riskPercent",
            "quantity"
          ]
        },
        "sizingValue": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SetupRiskTarget"
          }
        }
      },
      "required": [
        "walletId",
        "instrumentId",
        "direction",
        "entryPrice",
        "stopPrice",
        "sizingKind",
        "sizingValue",
        "targets"
      ]
    }
  }
}
