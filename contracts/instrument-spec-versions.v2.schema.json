{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WickdAlgo/wickd-api/contracts/instrument-spec-versions.v2.schema.json",
  "title": "InstrumentSpecVersionsPayload",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "instrument-spec-versions"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "$ref": "#/$defs/InstrumentSpecVersionList"
    }
  },
  "required": [
    "contract",
    "schemaVersion",
    "requestId",
    "asOf",
    "data"
  ],
  "$defs": {
    "InstrumentSpecVersion": {
      "type": "object",
      "properties": {
        "specVersionId": {
          "type": "string",
          "minLength": 1
        },
        "instrumentId": {
          "type": "string",
          "minLength": 1
        },
        "versionNumber": {
          "type": "integer"
        },
        "multiplier": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]\u002B)?$"
        },
        "quantityUnit": {
          "type": "string",
          "minLength": 1
        },
        "tickSize": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]\u002B)?$"
        },
        "lotSize": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]\u002B)?$"
        },
        "minQuantity": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]\u002B)?$"
        },
        "priceAssetId": {
          "type": "string",
          "minLength": 1
        },
        "payoffAssetId": {
          "type": "string",
          "minLength": 1
        },
        "valuationModel": {
          "type": "string",
          "minLength": 1
        },
        "effectiveFromUtc": {
          "type": "string",
          "format": "date-time"
        },
        "effectiveToUtc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "recordedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sourceVersion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "contentHash": {
          "type": "string",
          "minLength": 1
        },
        "sourceObservedAtUtc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "specVersionId",
        "instrumentId",
        "versionNumber",
        "multiplier",
        "quantityUnit",
        "tickSize",
        "lotSize",
        "minQuantity",
        "priceAssetId",
        "payoffAssetId",
        "valuationModel",
        "effectiveFromUtc",
        "effectiveToUtc",
        "recordedAtUtc",
        "source",
        "sourceVersion",
        "contentHash",
        "sourceObservedAtUtc"
      ]
    },
    "InstrumentSpecVersionList": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InstrumentSpecVersion"
          }
        }
      },
      "required": [
        "items"
      ]
    }
  }
}
