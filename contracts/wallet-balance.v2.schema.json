{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WickdAlgo/wickd-api/contracts/wallet-balance.v2.schema.json",
  "title": "WalletBalancePayload",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "contract": {
      "type": "string",
      "const": "wallet-balance"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "balanceBasis": {
      "anyOf": [
        {
          "$ref": "#/$defs/WalletBalanceBasisReceipt"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "contract",
    "requestId",
    "asOf",
    "balanceBasis"
  ],
  "$defs": {
    "WalletBalanceBasisReceipt": {
      "type": "object",
      "properties": {
        "receiptId": {
          "type": "string",
          "minLength": 1
        },
        "walletId": {
          "type": "string",
          "minLength": 1
        },
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        },
        "basisKind": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sourceFactId": {
          "type": "string",
          "minLength": 1
        },
        "sourceObservedAtUtc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "decisionAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "knownAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "quality": {
          "type": "string",
          "minLength": 1
        },
        "freshness": {
          "type": "string",
          "minLength": 1
        },
        "publicationSequence": {
          "type": "integer"
        }
      },
      "required": [
        "receiptId",
        "walletId",
        "assetId",
        "quantity",
        "basisKind",
        "source",
        "sourceFactId",
        "sourceObservedAtUtc",
        "decisionAtUtc",
        "knownAtUtc",
        "quality",
        "freshness",
        "publicationSequence"
      ]
    }
  }
}
