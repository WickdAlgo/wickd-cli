        "initialRiskAmount": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        }
      },
      "required": [
        "originalPlanRevisionId",
        "assetId",
        "initialRiskAmount"
      ]
    },
    "SetupPerformanceObservation": {
      "type": "object",
      "properties": {
        "setupId": {
          "type": "string",
          "minLength": 1
        },
        "walletId": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "paper",
            "live",
            "backtest",
            "shadow"
          ]
        },
        "inputSnapshotId": {
          "type": "string",
          "minLength": 1
        },
        "knownAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "decisionAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "finalCloseAtUtc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "state": {
          "type": "string",
          "enum": [
            "planned",
            "open",
            "closed",
            "skipped",
            "missed",
            "cancelled",
            "executedUnresolved"
          ]
        },
        "adherence": {
          "type": "string",
          "enum": [
            "followed",
            "violated",
            "unknown",
            "notApplicable"
          ]
        },
        "net": {
          "$ref": "#/$defs/SetupPerformanceMoney"
        },
        "originalRisk": {
          "$ref": "#/$defs/SetupPerformanceRisk"
        },
        "netInRiskAsset": {
          "anyOf": [
            {
              "$ref": "#/$defs/SetupPerformanceMoney"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "setupId",
        "walletId",
        "mode",
        "inputSnapshotId",
        "knownAtUtc",
        "decisionAtUtc",
        "finalCloseAtUtc",
        "state",
        "adherence",
        "net",
        "originalRisk"
      ]
    },
    "PaperSetupEconomicResult": {
      "type": "object",
      "properties": {
        "policyVersion": {
          "type": "string",
          "const": "paper-setup-net-declared-wallet-horizon-v1"
        },
        "observation": {
          "$ref": "#/$defs/SetupPerformanceObservation"
        },
        "walletOpeningAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "financialThroughExclusiveUtc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "coverageAttestationIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "inputIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hasUnassignedRetainedGraphPortions": {
          "type": "boolean"
        }
      },
      "required": [
        "policyVersion",
        "observation",
        "walletOpeningAtUtc",
        "financialThroughExclusiveUtc",
        "coverageAttestationIds",
