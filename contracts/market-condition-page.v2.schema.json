{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WickdAlgo/wickd-api/contracts/market-condition-page.v2.schema.json",
  "title": "MarketConditionPagePayload",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "market-condition-page"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "$ref": "#/$defs/MarketConditionPage"
    }
  },
  "required": [
    "contract",
    "schemaVersion",
    "requestId",
    "asOf",
    "data"
  ],
  "$defs": {
    "MarketConditionRevision": {
      "type": "object",
      "properties": {
        "tagId": {
          "type": "string",
          "minLength": 1
        },
        "revisionId": {
          "type": "string",
          "minLength": 1
        },
        "revisionNumber": {
          "type": "integer"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "archived": {
          "type": "boolean"
        },
        "contentHash": {
          "type": "string",
          "minLength": 1
        },
        "publicationSequence": {
          "type": "integer"
        },
        "knownAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "tagId",
        "revisionId",
        "revisionNumber",
        "label",
        "archived",
        "contentHash",
        "publicationSequence",
        "knownAtUtc"
      ]
    },
    "MarketConditionPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MarketConditionRevision"
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "publicationWatermark": {
          "type": "integer"
        }
      },
      "required": [
        "items",
        "nextCursor",
        "publicationWatermark"
      ]
    }
  }
}
