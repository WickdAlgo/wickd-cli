{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WickdAlgo/wickd-api/contracts/wallet-capital-create-request.v2.schema.json",
  "title": "WalletCapitalCreateRequest",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "deposit",
        "withdrawal"
      ]
    },
    "assetId": {
      "type": "string",
      "minLength": 1
    },
    "amount": {
      "type": "string",
      "pattern": "^(?!0(?:\\.0\u002B)?$)(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
      "description": "An exact decimal, carried as an invariant-culture string.",
      "maxLength": 60
    },
    "occurredAtUtc": {
      "type": "string",
      "format": "date-time",
      "maxLength": 32,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?(Z|[\u002B-]((0[0-9]|1[0-3]):[0-5][0-9]|14:00))(?![\\s\\S])"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "kind",
    "assetId",
    "amount",
    "occurredAtUtc",
    "reason"
  ]
}
