      ]
    },
    "InspectionChartLayer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "primitives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InspectionChartPrimitive"
          }
        },
        "defaultVisible": {
          "type": "boolean",
          "default": true
        },
        "z": {
          "type": "string",
          "enum": [
            "under",
            "over"
          ],
          "default": "under"
        }
      },
      "required": [
        "id",
        "label",
        "primitives"
      ]
    },
    "InspectionFilters": {
      "type": "object",
      "properties": {
        "families": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "swing",
              "marketStructureBreak",
              "liquidityPool",
              "liquiditySweep",
              "orderBlock",
              "expansionFvg"
            ]
          }
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "internal",
              "external"
            ]
          }
        },
        "directions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "bullish",
              "bearish",
              "neutral"
            ]
          }
        },
        "layerIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "families",
        "scopes",
        "directions",
        "layerIds"
      ]
    }
  }
}
