{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WickdAlgo/wickd-api/contracts/strategy-list-page.v2.schema.json",
  "title": "StrategyListPagePayload",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "strategy-list-page"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "$ref": "#/$defs/StrategyListPage"
    }
  },
  "required": [
    "contract",
    "schemaVersion",
    "requestId",
    "asOf",
    "data"
  ],
  "$defs": {
    "StrategySummary": {
      "type": "object",
      "properties": {
        "strategyId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 0
        },
        "researchStatus": {
          "type": "string",
          "minLength": 1
        },
        "metadataRevision": {
          "type": "integer"
        },
        "archived": {
          "type": "boolean"
        },
        "createdAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "publishedVersionCount": {
          "type": "integer"
        }
      },
      "required": [
        "strategyId",
        "name",
        "description",
        "researchStatus",
        "metadataRevision",
        "archived",
        "createdAtUtc",
        "publishedVersionCount"
      ]
    },
    "StrategyListPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StrategySummary"
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "publicationWatermark": {
          "type": "integer"
        }
      },
      "required": [
        "items",
        "nextCursor",
        "publicationWatermark"
      ]
    }
  }
}
