{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WickdAlgo/wickd-api/contracts/risk-preview.v2.schema.json",
  "title": "RiskPreviewEnvelope",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "contract": {
      "type": "string",
      "const": "risk-preview"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "$ref": "#/$defs/RiskPreviewReceipt"
    }
  },
  "required": [
    "schemaVersion",
    "contract",
    "requestId",
    "asOf",
    "data"
  ],
  "$defs": {
    "SetupRiskTarget": {
      "type": "object",
      "properties": {
        "ordinal": {
          "type": "integer"
        },
        "price": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        },
        "exitFraction": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        }
      },
      "required": [
        "ordinal",
        "price",
        "exitFraction"
      ]
    },
    "SetupRiskRequest": {
      "type": "object",
      "properties": {
        "walletId": {
          "type": "string",
          "minLength": 1
        },
        "instrumentId": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": [
            "long",
            "short"
          ]
        },
        "entryPrice": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        },
        "stopPrice": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        },
        "sizingKind": {
          "type": "string",
          "enum": [
            "riskAmount",
            "riskPercent",
            "quantity"
          ]
        },
        "sizingValue": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SetupRiskTarget"
          }
        }
      },
      "required": [
        "walletId",
        "instrumentId",
        "direction",
        "entryPrice",
        "stopPrice",
        "sizingKind",
        "sizingValue",
        "targets"
      ]
    },
    "SetupTargetRisk": {
      "type": "object",
      "properties": {
        "ordinal": {
          "type": "integer"
        },
        "price": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        },
        "r": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        },
        "exitFraction": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        }
      },
      "required": [
        "ordinal",
        "price",
        "r",
        "exitFraction"
      ]
    },
    "SetupRiskProjection": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer"
        },
        "contract": {
          "type": "string",
          "minLength": 1
        },
        "walletId": {
          "type": "string",
          "minLength": 1
        },
        "instrumentId": {
          "type": "string",
          "minLength": 1
        },
        "instrumentSpecVersionId": {
          "type": "string",
          "minLength": 1
        },
        "baselineAsset": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "chosenSizingValue": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        },
        "riskBudgetAmount": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        },
        "quantity": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        },
        "initialRiskAmount": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        },
        "positionValue": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        },
        "balanceAtPlan": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        },
        "riskPercentOfBalance": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        },
        "weightedPlannedR": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SetupTargetRisk"
          }
        },
        "incompleteReasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schemaVersion",
        "contract",
        "walletId",
        "instrumentId",
        "instrumentSpecVersionId",
        "baselineAsset",
        "policy",
        "chosenSizingValue",
        "riskBudgetAmount",
        "quantity",
        "initialRiskAmount",
        "positionValue",
        "balanceAtPlan",
        "riskPercentOfBalance",
        "weightedPlannedR",
        "targets",
        "incompleteReasons"
      ]
    },
    "RiskPreviewReceipt": {
      "type": "object",
      "properties": {
        "previewId": {
          "type": "string",
          "minLength": 1
        },
        "plan": {
          "$ref": "#/$defs/SetupRiskRequest"
        },
        "instrumentSpecVersionId": {
          "type": "string",
          "minLength": 1
        },
        "baselineAssetId": {
          "type": "string",
          "minLength": 1
        },
        "balanceBasisReceiptId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "projection": {
          "$ref": "#/$defs/SetupRiskProjection"
        },
        "canonicalInputHash": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "decisionAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "computedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "publicationSequence": {
          "type": "integer"
        }
      },
      "required": [
        "previewId",
        "plan",
        "instrumentSpecVersionId",
        "baselineAssetId",
        "balanceBasisReceiptId",
        "projection",
        "canonicalInputHash",
        "policy",
        "decisionAtUtc",
        "computedAtUtc",
        "expiresAtUtc",
        "publicationSequence"
      ]
    }
  }
}
