{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WickdAlgo/wickd-api/contracts/workspace-list.v2.schema.json",
  "title": "WorkspaceListPayload",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "contract": {
      "type": "string",
      "const": "workspace-list"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "workspaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WorkspaceContract"
      }
    }
  },
  "required": [
    "schemaVersion",
    "contract",
    "requestId",
    "asOf",
    "workspaces"
  ],
  "$defs": {
    "WorkspaceContract": {
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "personal": {
          "type": "boolean"
        },
        "createdAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "workspaceId",
        "name",
        "role",
        "personal",
        "createdAtUtc"
      ]
    }
  }
}
