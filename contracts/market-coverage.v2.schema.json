{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WickdAlgo/wickd-api/contracts/market-coverage.v2.schema.json",
  "title": "MarketCoveragePayload",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "contract": {
      "type": "string",
      "const": "market-coverage"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "seriesId": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MarketCoverage"
      }
    }
  },
  "required": [
    "schemaVersion",
    "contract",
    "requestId",
    "asOf",
    "seriesId",
    "items"
  ],
  "$defs": {
    "MarketCoverage": {
      "type": "object",
      "properties": {
        "startUtc": {
          "type": "string",
          "format": "date-time"
        },
        "endUtc": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "limitation": {
          "type": "string",
          "minLength": 1
        },
        "checkedAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "startUtc",
        "endUtc",
        "state",
        "limitation",
        "checkedAtUtc"
      ]
    }
  }
}
