{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WickdAlgo/wickd-api/contracts/paper-cost-create-request.v2.schema.json",
  "title": "PaperCostCreateRequest",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "commission",
        "funding",
        "rebate",
        "borrowInterest",
        "liquidation",
        "other"
      ]
    },
    "assetId": {
      "type": "string",
      "minLength": 1
    },
    "amount": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
      "description": "An exact decimal, carried as an invariant-culture string.",
      "maxLength": 60
    },
    "occurredAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "kind",
    "assetId",
    "amount",
    "occurredAtUtc",
    "reason"
  ]
}
