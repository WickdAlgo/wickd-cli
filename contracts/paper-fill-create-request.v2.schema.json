{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WickdAlgo/wickd-api/contracts/paper-fill-create-request.v2.schema.json",
  "title": "PaperFillCreateRequest",
  "type": "object",
  "properties": {
    "instrumentId": {
      "type": "string",
      "minLength": 1
    },
    "instrumentSpecVersionId": {
      "type": "string",
      "minLength": 1
    },
    "side": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ]
    },
    "positionSide": {
      "type": "string",
      "enum": [
        "net",
        "hedgeLong",
        "hedgeShort"
      ]
    },
    "price": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
      "description": "An exact decimal, carried as an invariant-culture string.",
      "maxLength": 60
    },
    "quantity": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
      "description": "An exact decimal, carried as an invariant-culture string.",
      "maxLength": 60
    },
    "occurredAtUtc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "instrumentId",
    "instrumentSpecVersionId",
    "side",
    "positionSide",
    "price",
    "quantity",
    "occurredAtUtc"
  ]
}
