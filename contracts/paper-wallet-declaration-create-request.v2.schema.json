{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WickdAlgo/wickd-api/contracts/paper-wallet-declaration-create-request.v2.schema.json",
  "title": "PaperWalletDeclarationCreateRequest",
  "type": "object",
  "properties": {
    "throughOccurredAtUtc": {
      "type": "string",
      "format": "date-time",
      "maxLength": 32,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?(Z|[\u002B-]((0[0-9]|1[0-3]):[0-5][0-9]|14:00))(?![\\s\\S])"
    },
    "claims": {
      "$ref": "#/$defs/PaperWalletZeroOnlyClaims"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "throughOccurredAtUtc",
    "claims",
    "reason"
  ],
  "$defs": {
    "PaperWalletZeroOnlyClaims": {
      "type": "object",
      "properties": {
        "openingNonCashHoldingsKnownZero": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "openingPositionsKnownFlat": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "liabilitiesKnownZeroThroughout": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "allManualFillsRecorded": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "allCapitalMovementsRecorded": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "openingNonCashHoldingsKnownZero",
        "openingPositionsKnownFlat",
        "liabilitiesKnownZeroThroughout",
        "allManualFillsRecorded",
        "allCapitalMovementsRecorded"
      ]
    }
  }
}
