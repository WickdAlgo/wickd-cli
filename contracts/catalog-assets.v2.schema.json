{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WickdAlgo/wickd-api/contracts/catalog-assets.v2.schema.json",
  "title": "CatalogAssetsPayload",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "catalog-assets"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "$ref": "#/$defs/CatalogAssetList"
    }
  },
  "required": [
    "contract",
    "schemaVersion",
    "requestId",
    "asOf",
    "data"
  ],
  "$defs": {
    "CatalogAsset": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "canonicalCode": {
          "type": "string",
          "minLength": 1
        },
        "chainId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "contractIdentity": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "displayPrecision": {
          "type": "integer"
        }
      },
      "required": [
        "assetId",
        "canonicalCode",
        "chainId",
        "contractIdentity",
        "displayPrecision"
      ]
    },
    "CatalogAssetList": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CatalogAsset"
          }
        }
      },
      "required": [
        "items"
      ]
    }
  }
}
