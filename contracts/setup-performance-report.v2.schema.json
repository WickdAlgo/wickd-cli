        },
        "coverageAttestationIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "walletId",
        "openingAtUtc",
        "financialThroughExclusiveUtc",
        "coverageAttestationIds"
      ]
    },
    "SetupPerformanceMoney": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        },
        "incompleteReasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "assetId",
        "amount",
        "incompleteReasons"
      ]
    },
    "SetupPerformanceRisk": {
