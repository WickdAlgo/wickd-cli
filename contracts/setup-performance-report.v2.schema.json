{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WickdAlgo/wickd-api/contracts/setup-performance-report.v2.schema.json",
  "title": "SetupPerformanceReportEnvelope",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "contract": {
      "type": "string",
      "const": "setup-performance-report"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "$ref": "#/$defs/SetupPerformanceReportRevision"
    },
    "publicationWatermark": {
      "type": "integer"
    },
    "snapshotCursor": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "contract",
    "requestId",
    "asOf",
    "data",
    "publicationWatermark",
    "snapshotCursor"
  ],
  "$defs": {
    "SetupPerformanceQueryRequest": {
      "type": "object",
      "properties": {
        "sampleUnit": {
          "type": "string",
          "const": "setup"
        },
        "mode": {
          "type": "string",
          "enum": [
            "paper",
            "live",
            "backtest",
            "shadow"
          ]
        },
        "dateAxis": {
          "type": "string",
          "enum": [
            "decisionAt",
            "closedAt"
          ]
        },
        "fromUtc": {
          "type": "string",
          "format": "date-time",
          "maxLength": 33,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,7})?(Z|[\u002B-]((0[0-9]|1[0-3]):[0-5][0-9]|14:00))(?![\\s\\S])"
        },
        "toUtc": {
          "type": "string",
          "format": "date-time",
          "maxLength": 33,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,7})?(Z|[\u002B-]((0[0-9]|1[0-3]):[0-5][0-9]|14:00))(?![\\s\\S])"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "adherence": {
          "type": "string",
          "enum": [
            "all",
            "followed",
            "violated",
            "unknown",
            "notApplicable"
          ]
        },
        "reportingCurrency": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "netPnl",
              "winRate",
              "meanRealizedR",
              "cumulativeRealizedR",
              "cumulativeRDrawdown",
              "equityDrawdown"
            ]
          },
          "minItems": 1,
          "maxItems": 64
        },
        "strategyId": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "minLength": 1
        },
        "strategyVersionIds": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": null,
          "maxItems": 1000
        },
        "walletIds": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": null,
          "maxItems": 1000
        },
        "instrumentIds": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": null,
          "maxItems": 1000
        },
        "direction": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "long",
                "short"
              ],
              "default": null
            },
            {
              "type": "null"
            }
          ]
        },
        "primaryTimeframeIds": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": null,
          "maxItems": 1000
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "planned",
                "executed",
                "open",
                "closed",
                "executedUnresolved",
                "skipped",
                "missed",
                "cancelled"
              ],
              "default": null
            },
            {
              "type": "null"
            }
          ]
        },
        "disposition": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "planned",
                "skipped",
                "missed",
                "cancelled"
              ],
              "default": null
            },
            {
              "type": "null"
            }
          ]
        },
        "sessionDefinitionVersionId": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "minLength": 1
        },
        "marketConditionTagId": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "minLength": 1
        }
      },
      "required": [
        "sampleUnit",
        "mode",
        "dateAxis",
        "fromUtc",
        "toUtc",
        "timezone",
        "adherence",
        "reportingCurrency",
        "metrics"
      ]
    },
    "PaperSetupPerformanceWalletHorizon": {
      "type": "object",
