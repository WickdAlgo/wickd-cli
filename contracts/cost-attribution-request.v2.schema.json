{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WickdAlgo/wickd-api/contracts/cost-attribution-request.v2.schema.json",
  "title": "CostAttributionRequest",
  "type": "object",
  "properties": {
    "costId": {
      "type": "string",
      "minLength": 1
    },
    "priorRevisionId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "allocations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CostAttributionInput"
      },
      "maxItems": 2000
    }
  },
  "required": [
    "costId",
    "priorRevisionId",
    "reason",
    "allocations"
  ],
  "$defs": {
    "CostAttributionInput": {
      "type": "object",
      "properties": {
        "setupId": {
          "type": "string",
          "minLength": 1
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        }
      },
      "required": [
        "setupId",
        "attemptId",
        "amount"
      ]
    }
  }
}
