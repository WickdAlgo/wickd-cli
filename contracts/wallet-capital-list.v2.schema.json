{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WickdAlgo/wickd-api/contracts/wallet-capital-list.v2.schema.json",
  "title": "WalletCapitalListEnvelope",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "contract": {
      "type": "string",
      "const": "wallet-capital-list"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WalletCapitalMovement"
      }
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "publicationWatermark": {
      "type": "integer"
    },
    "snapshotCursor": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "contract",
    "requestId",
    "asOf",
    "items",
    "nextCursor",
    "publicationWatermark",
    "snapshotCursor"
  ],
  "$defs": {
    "WalletCapitalMovement": {
      "type": "object",
      "properties": {
        "movementId": {
          "type": "string",
          "minLength": 1
        },
        "walletId": {
          "type": "string",
          "minLength": 1
        },
        "economicEventId": {
          "type": "string",
          "minLength": 1
        },
        "ledgerTransactionId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "deposit",
            "withdrawal"
          ]
        },
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "string",
          "pattern": "^(?!0(?:\\.0\u002B)?$)(0|[1-9][0-9]*)(\\.[0-9]{1,28})?$",
          "description": "An exact decimal, carried as an invariant-culture string.",
          "maxLength": 60
        },
        "occurredAtUtc": {
          "type": "string",
          "format": "date-time",
          "maxLength": 32,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?(Z|[\u002B-]((0[0-9]|1[0-3]):[0-5][0-9]|14:00))(?![\\s\\S])"
        },
        "knownAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "publicationSequence": {
          "type": "integer"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "recordedByUserId": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "const": "userDeclaredPaperCapital"
        },
        "ledgerPolicyVersion": {
          "type": "string",
          "const": "paper-wallet-capital-ledger-v1"
        }
      },
      "required": [
        "movementId",
        "walletId",
        "economicEventId",
        "ledgerTransactionId",
        "kind",
        "assetId",
        "amount",
        "occurredAtUtc",
        "knownAtUtc",
        "publicationSequence",
        "reason",
        "recordedByUserId",
        "source",
        "ledgerPolicyVersion"
      ]
    }
  }
}
