{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WickdAlgo/wickd-api/contracts/paper-history-correction-request.v2.schema.json",
  "title": "PaperHistoryCorrectionRequest",
  "type": "object",
  "properties": {
    "replacement": {
      "$ref": "#/$defs/PaperHistoryCreateRequest"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "replacement",
    "reason"
  ],
  "$defs": {
    "PaperHistoryCreateRequest": {
      "type": "object",
      "properties": {
        "instrumentSpecVersionId": {
          "type": "string",
          "minLength": 1
        },
        "openingKnownFlat": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "allManualFillsRecorded": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fromOccurredAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "throughOccurredAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "instrumentSpecVersionId",
        "openingKnownFlat",
        "allManualFillsRecorded",
        "fromOccurredAtUtc",
        "throughOccurredAtUtc"
      ]
    }
  }
}
