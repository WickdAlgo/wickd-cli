{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WickdAlgo/wickd-dotnet/contracts/supported-instruments.v1.schema.json",
  "title": "SupportedInstrumentsPayload",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "contract": {
      "type": "string",
      "const": "supported-instruments"
    },
    "provenance": {
      "$ref": "#/$defs/TradeJournalProvenance"
    },
    "instruments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SupportedInstrument"
      }
    },
    "timeframes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "contract",
    "provenance",
    "instruments",
    "timeframes"
  ],
  "$defs": {
    "TradeJournalProvenance": {
      "type": "object",
      "properties": {
        "generatedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "applicationVersion": {
          "type": "string",
          "minLength": 1
        },
        "inspectionRunId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "sourceInspectionSchemaVersion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "generatedAtUtc",
        "applicationVersion",
        "inspectionRunId",
        "sourceInspectionSchemaVersion"
      ]
    },
    "SupportedInstrument": {
      "type": "object",
      "properties": {
        "marketId": {
          "type": "string",
          "minLength": 1
        },
        "exchangeId": {
          "type": "string",
          "minLength": 1
        },
        "exchangeSymbol": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "marketId",
        "exchangeId",
        "exchangeSymbol"
      ]
    }
  }
}
