{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WickdAlgo/wickd-dotnet/contracts/account-risk.v1.schema.json",
  "title": "AccountRiskEvaluation",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "contract": {
      "type": "string",
      "const": "account-risk"
    },
    "provenance": {
      "$ref": "#/$defs/TradeJournalProvenance"
    },
    "accountId": {
      "type": "string",
      "minLength": 1
    },
    "asOfUtc": {
      "type": "string",
      "format": "date-time"
    },
    "openRisk": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "An exact decimal, carried as an invariant-culture string."
    },
    "concurrentRiskWarnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ConcurrentRiskWarning"
      }
    }
  },
  "required": [
    "schemaVersion",
    "contract",
    "provenance",
    "accountId",
    "asOfUtc",
    "openRisk",
    "concurrentRiskWarnings"
  ],
  "$defs": {
    "TradeJournalProvenance": {
      "type": "object",
      "properties": {
        "generatedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "applicationVersion": {
          "type": "string",
          "minLength": 1
        },
        "inspectionRunId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "sourceInspectionSchemaVersion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "generatedAtUtc",
        "applicationVersion",
        "inspectionRunId",
        "sourceInspectionSchemaVersion"
      ]
    },
    "ConcurrentRiskWarning": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "accountId": {
          "type": "string",
          "minLength": 1
        },
        "executionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2
        },
        "combinedRiskAmount": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "description": "An exact decimal, carried as an invariant-culture string."
        }
      },
      "required": [
        "id",
        "accountId",
        "executionIds",
        "combinedRiskAmount"
      ]
    }
  }
}
